{
  "name": "MiniMax",
  "version": "1.1.0",
  "credential_type": "llm_minimax",
  "author": "Keyrealm",
  "description": "验证 MiniMax API Key 有效性（按量付费 / Token Plan），支持 M Plan 套餐额度查询",
  "icon": "logo.png",
  "fields": [
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "placeholder": "默认 https://api.minimax.cn/v1（国际站 https://api.minimax.io/v1）",
      "default": "https://api.minimax.cn/v1",
      "presets": [
        {
          "label": "MiniMax 国内站",
          "value": "https://api.minimax.cn/v1"
        },
        {
          "label": "MiniMax 国际站",
          "value": "https://api.minimax.io/v1"
        }
      ]
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "sk-..."
    },
    {
      "key": "probe_chat",
      "label": "验证通过后再发一次对话探测",
      "type": "checkbox",
      "required": false,
      "hint": "M Plan 订阅 Key 会直接查询套餐额度（五小时 / 周剩余），不再执行本项；按量付费 Key 查不到套餐时，开启后会额外发一次 max_tokens=1 的对话请求判断账户是否可用（会消耗极少量额度）。默认关闭。"
    },
    {
      "key": "probe_model",
      "label": "探测使用的模型",
      "type": "model",
      "required": false,
      "placeholder": "留空自动选择",
      "hint": "留空 = 自动从该凭据的模型列表里挑一个便宜的（优先 flash / lite / mini 等）。"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
