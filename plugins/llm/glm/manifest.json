{
  "name": "智谱 GLM",
  "version": "1.1.0",
  "credential_type": "llm_glm",
  "author": "Keyrealm",
  "description": "验证 智谱 GLM API Key 有效性",
  "icon": "logo.png",
  "fields": [
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "placeholder": "留空使用默认地址",
      "hint": "留空走普通平台端点 /api/paas/v4；GLM Coding Plan 套餐请填 https://open.bigmodel.cn/api/coding/paas/v4。",
      "presets": [
        {
          "label": "智谱开放平台",
          "value": "https://open.bigmodel.cn/api/paas/v4"
        },
        {
          "label": "智谱 GLM Coding Plan",
          "value": "https://open.bigmodel.cn/api/coding/paas/v4"
        },
        {
          "label": "Z.ai 国际站",
          "value": "https://api.z.ai/api/paas/v4"
        }
      ]
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "sk-..."
    },
    {
      "key": "probe_chat",
      "label": "余额未知时发一次对话探测",
      "type": "checkbox",
      "required": false,
      "hint": "厂商无余额接口、或中转站令牌为「不限额度」时，验证会额外发一次 max_tokens=1 的对话请求实测账户是否可用（会消耗极少量额度）。默认关闭。"
    },
    {
      "key": "probe_model",
      "label": "探测使用的模型",
      "type": "model",
      "required": false,
      "placeholder": "留空自动选择",
      "hint": "留空 = 自动从该凭据的模型列表里挑一个便宜的（优先 flash / lite / mini 等）。"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
