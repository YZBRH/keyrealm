{
  "name": "阿里云百炼 DashScope",
  "version": "1.0.0",
  "credential_type": "llm_dashscope",
  "author": "Keyrealm",
  "description": "验证 阿里云百炼 DashScope API Key 有效性",
  "icon": "logo.png",
  "fields": [
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "placeholder": "留空使用默认地址",
      "default": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "presets": [
        {
          "label": "阿里云百炼 · 华北2（北京）",
          "value": "https://dashscope.aliyuncs.com/compatible-mode/v1"
        },
        {
          "label": "阿里云百炼 · 新加坡（国际）",
          "value": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
        }
      ]
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "sk-..."
    },
    {
      "key": "probe_chat",
      "label": "余额未知时发一次对话探测",
      "type": "checkbox",
      "required": false,
      "hint": "厂商无余额接口、或中转站令牌为「不限额度」时，验证会额外发一次 max_tokens=1 的对话请求实测账户是否可用（会消耗极少量额度）。默认关闭。"
    },
    {
      "key": "probe_model",
      "label": "探测使用的模型",
      "type": "model",
      "required": false,
      "placeholder": "留空自动选择",
      "hint": "留空 = 自动从该凭据的模型列表里挑一个便宜的（优先 flash / lite / mini 等）。"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
