{
  "name": "月之暗面 Moonshot",
  "version": "1.0.0",
  "credential_type": "llm_moonshot",
  "author": "Keyrealm",
  "description": "验证 月之暗面 Moonshot API Key 有效性，支持余额查询",
  "icon": "logo.png",
  "fields": [
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "placeholder": "留空使用默认地址",
      "default": "https://api.moonshot.cn/v1",
      "presets": [
        {
          "label": "Kimi 中国站",
          "value": "https://api.moonshot.cn/v1"
        },
        {
          "label": "Kimi 国际站",
          "value": "https://api.moonshot.ai/v1"
        }
      ]
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "sk-..."
    },
    {
      "key": "probe_chat",
      "label": "余额未知时发一次对话探测",
      "type": "checkbox",
      "required": false,
      "hint": "厂商无余额接口、或中转站令牌为「不限额度」时，验证会额外发一次 max_tokens=1 的对话请求实测账户是否可用（会消耗极少量额度）。默认关闭。"
    },
    {
      "key": "probe_model",
      "label": "探测使用的模型",
      "type": "model",
      "required": false,
      "placeholder": "留空自动选择",
      "hint": "留空 = 自动从该凭据的模型列表里挑一个便宜的（优先 flash / lite / mini 等）。"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
