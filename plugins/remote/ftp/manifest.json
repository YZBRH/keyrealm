{
  "name": "FTP",
  "version": "1.0.0",
  "credential_type": "remote_ftp",
  "author": "Keyrealm",
  "description": "管理 FTP / FTPS 登录凭据并验证登录（支持匿名与显式 TLS）",
  "icon": "logo.svg",
  "fields": [
    {
      "key": "host",
      "label": "主机",
      "type": "text",
      "required": true,
      "placeholder": "192.0.2.10 或 ftp.example.com"
    },
    {
      "key": "port",
      "label": "端口",
      "type": "text",
      "required": true,
      "default": "21",
      "placeholder": "21"
    },
    {
      "key": "username",
      "label": "用户名",
      "type": "text",
      "required": false,
      "placeholder": "留空使用 anonymous"
    },
    {
      "key": "password",
      "label": "密码",
      "type": "password",
      "sensitive": true,
      "required": false,
      "placeholder": "登录密码（匿名可留空）",
      "hint": "登录验证会在目标侧产生一次认证记录。"
    },
    {
      "key": "tls",
      "label": "TLS 方式",
      "type": "select",
      "required": true,
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "普通 FTP"
        },
        {
          "value": "explicit",
          "label": "显式 FTPS（AUTH TLS）"
        }
      ],
      "hint": "隐式 FTPS 请改用支持该模式的客户端；本插件只实现显式 AUTH TLS。"
    },
    {
      "key": "passive",
      "label": "被动模式",
      "type": "checkbox",
      "required": false,
      "default": true,
      "hint": "默认开启；登录验证本身不传输数据，此设置保留给后续文件操作。"
    },
    {
      "key": "timeout",
      "label": "超时（秒）",
      "type": "text",
      "required": false,
      "default": "15",
      "hint": "连接 / 登录超时。"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
