{
  "name": "百度 AI 开放平台",
  "version": "1.1.0",
  "credential_type": "api_baidu_ai",
  "author": "Keyrealm",
  "description": "验证百度 AI 开放平台 API Key / Secret Key（或直填 access_token），可浏览人脸库并枚举已开通的产品权限",
  "icon": "logo.png",
  "fields": [
    {
      "key": "auth_mode",
      "label": "密钥种类",
      "type": "select",
      "required": true,
      "default": "ak_sk",
      "options": [
        {
          "value": "ak_sk",
          "label": "API Key + Secret Key"
        },
        {
          "value": "access_token",
          "label": "直填 access_token"
        }
      ],
      "hint": "AK/SK 走 OAuth client_credentials 换取 access_token（约 30 天）；已有 token 可直接粘贴，跳过换 token。"
    },
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "placeholder": "留空使用默认地址",
      "default": "https://aip.baidubce.com",
      "presets": [
        {
          "label": "百度 AI 开放平台",
          "value": "https://aip.baidubce.com"
        }
      ]
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "show_if": {
        "auth_mode": "ak_sk"
      },
      "placeholder": "百度智能云「应用」里的 API Key"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "show_if": {
        "auth_mode": "ak_sk"
      },
      "placeholder": "与 API Key 成对的 Secret Key",
      "hint": "与 API Key 成对出现；二者只用于换取 access_token，不要求应用已开通人脸识别。"
    },
    {
      "key": "access_token",
      "label": "access_token",
      "type": "password",
      "required": true,
      "sensitive": true,
      "show_if": {
        "auth_mode": "access_token"
      },
      "placeholder": "24.xxxxxxxxxxxxxxxx",
      "hint": "百度 AI 开放平台的 access_token（约 30 天有效）。验证时自动用内置只读接口探测，无需额外配置。"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
