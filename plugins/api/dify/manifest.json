{
  "name": "Dify",
  "version": "1.0.0",
  "credential_type": "api_dify",
  "author": "Keyrealm",
  "description": "验证 Dify 应用 API Key 有效性（GET /parameters，只读）",
  "icon": "logo.svg",
  "fields": [
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "app-…"
    },
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "default": "https://api.dify.ai/v1",
      "placeholder": "https://api.dify.ai/v1",
      "hint": "官方云填 https://api.dify.ai/v1；自建实例填自己的地址（含版本前缀，如 http://host/v1）。",
      "presets": [
        {
          "label": "Dify Cloud",
          "value": "https://api.dify.ai/v1"
        }
      ]
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
