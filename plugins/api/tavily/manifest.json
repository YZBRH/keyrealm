{
  "name": "Tavily",
  "version": "1.1.0",
  "credential_type": "api_tavily",
  "author": "Keyrealm",
  "description": "验证 Tavily API Key 有效性",
  "icon": "logo.png",
  "fields": [
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "placeholder": "留空使用默认地址",
      "default": "https://api.tavily.com",
      "presets": [
        {
          "label": "Tavily 官方",
          "value": "https://api.tavily.com"
        }
      ]
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "tvly-..."
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
