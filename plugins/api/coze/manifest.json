      "presets": [
        {
          "label": "国内站 coze.cn",
          "value": "https://api.coze.cn"
        },
        {
          "label": "国际站 coze.com",
          "value": "https://api.coze.com"
        }
      ]
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "pat_..."
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
