{
  "name": "百度 AI 开放平台",
  "version": "1.1.0",
  "credential_type": "api_baidu_ai",
  "author": "Keyrealm",
  "description": "验证百度 AI 开放平台 API Key / Secret Key（或直填 access_token），可浏览人脸库并枚举已开通的产品权限",
  "icon": "logo.png",
  "fields": [
    {
      "key": "auth_mode",
      "label": "密钥种类",
      "type": "select",
      "required": true,
      "default": "ak_sk",
      "options": [
        {
          "value": "ak_sk",
          "label": "API Key + Secret Key"
        },
        {
          "value": "access_token",
          "label": "直填 access_token"
        }
      ],
      "hint": "AK/SK 走 OAuth client_credentials 换取 access_token（约 30 天）；已有 token 可直接粘贴，跳过换 token。"
    },
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "placeholder": "留空使用默认地址",
      "default": "https://aip.baidubce.com",
      "presets": [
        {
          "label": "百度 AI 开放平台",
          "value": "https://aip.baidubce.com"
        }
      ]
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "show_if": {
        "auth_mode": "ak_sk"
      },
      "placeholder": "百度智能云「应用」里的 API Key"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "show_if": {
        "auth_mode": "ak_sk"
      },
      "placeholder": "与 API Key 成对的 Secret Key",
      "hint": "与 API Key 成对出现；二者只用于换取 access_token，不要求应用已开通人脸识别。"
    },
    {
      "key": "access_token",
      "label": "access_token",
      "type": "password",
      "required": true,
      "sensitive": true,
      "show_if": {
        "auth_mode": "access_token"
      },
      "placeholder": "24.xxxxxxxxxxxxxxxx",
      "hint": "百度 AI 开放平台的 access_token（约 30 天有效）。直填模式需要再配置一个只读探测接口来确认 token 有效性。"
    },
    {
      "key": "probe_path",
      "label": "验证探测路径",
      "type": "text",
      "required": false,
      "default": "/rest/2.0/face/v3/faceset/group/getlist",
      "show_if": {
        "auth_mode": "access_token"
      },
      "hint": "仅直填 access_token 模式使用；填该应用已开通产品的只读接口路径，必须以 / 开头。默认人脸库分组列表。"
    },
    {
      "key": "probe_body",
      "label": "验证探测请求体（JSON）",
      "type": "textarea",
      "required": false,
      "default": "{\"start\":0,\"length\":1}",
      "show_if": {
        "auth_mode": "access_token"
      },
      "hint": "仅直填 access_token 模式使用；必须是 JSON 对象。人脸分组用 {\"start\":0,\"length\":1}，词法分析用 {\"text\":\"ping\"}。"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
