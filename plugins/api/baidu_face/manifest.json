{
  "name": "百度人脸",
  "version": "1.0.1",
  "credential_type": "api_baidu_face",
  "author": "Keyrealm",
  "description": "验证 百度人脸（人脸识别）API Key / Secret Key 有效性，并可浏览人脸库分组",
  "icon": "logo.png",
  "fields": [
    {
      "key": "base_url",
      "label": "Base URL",
      "type": "url",
      "required": false,
      "placeholder": "留空使用默认地址",
      "default": "https://aip.baidubce.com",
      "presets": [
        {
          "label": "百度智能云 AIP",
          "value": "https://aip.baidubce.com"
        }
      ]
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "百度智能云「应用」里的 API Key"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "与 API Key 成对的 Secret Key",
      "hint": "在百度智能云「应用」里与 API Key 成对出现，两个都要填齐。所校验的接口需该应用已开通「人脸识别」。"
    },
    {
      "key": "notes",
      "label": "备注",
      "type": "textarea",
      "required": false
    }
  ]
}
