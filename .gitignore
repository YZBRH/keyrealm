# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
dist-launcher/
build-launcher/
.eggs/
venv/
.venv/
env/

# 打包产物（PyInstaller 输出 + 源码归档，不入库；Keyrealm.spec 与 scripts/*.py 是构建配置，保留追踪）
release/
# 测试版更新「准备阶段」的构建落点（交棒时安装进程序目录，装完即清）
.update-staged/
# 启动器 + onedir 发行布局的运行目录（构建产物 / 更新中间态，不入库）
/runtime/
/runtime.old/
/runtime.bad/
/runtime.new/
/.runtime-new/
/.update-meta/
/.update-new/
# 构建产物默认落**仓库根**（.git 同级）：可执行文件本身，以及覆盖前的回滚副本 .old。
# 注意：Keyrealm* 也会匹配 Keyrealm.spec，但该文件已被追踪，gitignore 不影响已追踪文件。
Keyrealm*
# 更新备份目录：现在落在 data/backup/（见 .gitignore 里的 data/，自然被忽略）；
# 这条留着兼容老版本留在程序根的 backups/
backups/

# 中间产物目录（不入库）
tmp/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Runtime data（用户数据，不入库）
data/
*.db
*.db-wal
*.db-shm
master.key

# 插件启用/禁用状态（本机运行时状态，不入库；发行包也不带它）
plugins/.state.json*
plugins/.model_cache.json*

# 本机配置（数据目录等；随部署环境不同，不入库）
keyrealm.conf.json
keyrealm.conf.json.tmp

# 构建时生成（commit hash 注入，由 scripts/build.py 写；不入库）
backend/_build_info.py

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# 环境变量
.env
.env.local
